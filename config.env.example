# 서버에서는 이 파일을 config.env 로 복사해 고친다. systemd 가 읽어 앱에 넣는다.
# 바꾼 뒤에는 sudo systemctl restart guestbook

# 내 서비스로 만들기 (1학년 5단원). 화면 맨 위 앱 이름과 그 아래 소개 문장
GUESTBOOK_TITLE=오늘 급식
GUESTBOOK_INTRO=우리 반이 운영하는 급식 리뷰
# 헤더 날짜 옆에 붙는 끼니 이름
MEAL_NAME=점심

# 앱 포트. 학교망 때문에 80 을 쓴다
PORT=80
AWS_REGION=ap-northeast-2

# 저장소: file | mysql | dynamodb
STORAGE=file
DATA_FILE=/var/lib/guestbook/entries.json

# S3 오늘 메뉴와 공지 (1학년 9단원, 2일차). 버킷 이름만 적는다. 키는 notice.txt
# notice.txt 에 「칸|음식|알레르기」 줄(예: 반찬|닭갈비|5.6.13)이 있으면 식판에 메뉴로, 아니면 공지 문장으로 보인다
NOTICE_BUCKET=

# 급식 사진 첨부 (개선 메뉴 1). 사진은 이 버킷의 images/ 아래에 올라간다
IMAGE_BUCKET=

# DynamoDB (개선 메뉴 2, 2학년 11단원)
DYNAMODB_TABLE=guestbook

# MySQL (2학년 4단원, 심화 메뉴 5). 접속 정보는 Parameter Store 에서 읽는다
PARAM_PREFIX=/guestbook/db
DB_USER=admin
DB_PORT=3306
DB_NAME=guestbook

# 급식실 한마디(오늘의 한마디) Lambda 주소 (1학년 13단원)
HELLO_API_URL=

# 로드 밸런서 대상 그룹 ARN. 적으면 운영 띠에 「서버 2/2 정상」이 보인다
# 서버 역할에 elasticloadbalancing:DescribeTargetHealth 권한이 있어야 한다. 비워 두면 그 칸을 숨긴다
TARGET_GROUP_ARN=
