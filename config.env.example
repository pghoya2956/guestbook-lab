# 서버에서는 이 파일을 config.env 로 복사해 고친다. systemd 가 읽어 앱에 넣는다.
# 바꾼 뒤에는 sudo systemctl restart guestbook

# 내 방명록으로 만들기 (1학년 6단원)
GUESTBOOK_TITLE=우리 반 방명록
GUESTBOOK_INTRO=이름과 한마디를 남겨 주세요.

# 앱 포트. 학교망 때문에 80 을 쓴다
PORT=80
AWS_REGION=ap-northeast-2

# 저장소: file | mysql | dynamodb
STORAGE=file
DATA_FILE=/var/lib/guestbook/entries.json

# S3 공지 (1학년 9단원). 버킷 이름만 적는다. 키는 notice.txt
NOTICE_BUCKET=

# 이미지 첨부 (개선 메뉴 1)
IMAGE_BUCKET=

# DynamoDB (개선 메뉴 2, 2학년 11단원)
DYNAMODB_TABLE=guestbook

# MySQL (2학년 4단원). 접속 정보는 Parameter Store 에서 읽는다
PARAM_PREFIX=/guestbook/db
DB_USER=admin
DB_NAME=guestbook

# 오늘의 한마디 Lambda 주소 (1학년 16단원, 개선 메뉴 3)
HELLO_API_URL=
